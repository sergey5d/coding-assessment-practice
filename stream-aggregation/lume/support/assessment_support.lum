module assessment_support

use spec/*
use src/record_aggregator/{Rollup}

def expect_strings(actual [Str], expected [Str]) Unit {
    actual.size.shouldBe(expected.size)
    for index <- Range(0, expected.size) {
        (actual.at(index) ?? "<missing>").shouldBe(expected.at(index) ?? "<missing>")
    }
}

def expect_rollup(actual Rollup?, expected_count Int, expected_total Int) Unit {
    actual.isSet.shouldBe(true)
    value = (actual ?? Rollup(-1, -1))
    value.count.shouldBe(expected_count)
    value.total.shouldBe(expected_total)
}

