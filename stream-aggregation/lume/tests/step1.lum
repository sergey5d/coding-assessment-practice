module step1

use spec/*
use src/record_aggregator/{RecordAggregator, Rollup}
use support/assessment_support/{expect_rollup}

class Step1SingleRecordSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,25").shouldBe(true)
        expect_rollup(aggregator.get_rollup("alice"), 1, 25)
    }
}

class Step1MultipleRecordsSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,25")
        aggregator.ingest("r2,11,alice,15")
        aggregator.ingest("r3,12,alice,-5")
        expect_rollup(aggregator.get_rollup("alice"), 3, 35)
    }
}

class Step1IndependentKeysSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,25")
        aggregator.ingest("r2,11,bob,40")
        expect_rollup(aggregator.get_rollup("alice"), 1, 25)
        expect_rollup(aggregator.get_rollup("bob"), 1, 40)
        aggregator.get_rollup("missing").isEmpty.shouldBe(true)
    }
}

class Step1WhitespaceSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("  r1  ,  10 , alice , -7  ").shouldBe(true)
        expect_rollup(aggregator.get_rollup("alice"), 1, -7)
    }
}

class Step1FieldCountSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice").shouldBe(false)
        aggregator.ingest("r2,10,alice,5,extra").shouldBe(false)
        aggregator.get_rollup("alice").isEmpty.shouldBe(true)
    }
}

class Step1EmptyFieldsSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest(",10,alice,5").shouldBe(false)
        aggregator.ingest("r2,10, ,5").shouldBe(false)
        aggregator.get_rollup("alice").isEmpty.shouldBe(true)
    }
}

class Step1InvalidNumbersSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,-1,alice,5").shouldBe(false)
        aggregator.ingest("r2,1.5,alice,5").shouldBe(false)
        aggregator.ingest("r3,1,alice,2.5").shouldBe(false)
        aggregator.ingest("r4,1,alice,5x").shouldBe(false)
        aggregator.ingest("r5,9223372036854775808,alice,5").shouldBe(false)
        aggregator.get_rollup("alice").isEmpty.shouldBe(true)
    }
}

class Step1DuplicateIdSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,25").shouldBe(true)
        aggregator.ingest("r1,20,bob,100").shouldBe(false)
        expect_rollup(aggregator.get_rollup("alice"), 1, 25)
        aggregator.get_rollup("bob").isEmpty.shouldBe(true)
    }
}

class Step1MalformedIdReservationSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,bad,alice,25").shouldBe(false)
        aggregator.ingest("r1,10,alice,25").shouldBe(true)
    }
}

class Step1ZeroAndNegativeTotalsSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,0")
        aggregator.ingest("r2,2,bob,-10")
        expect_rollup(aggregator.get_rollup("alice"), 1, 0)
        expect_rollup(aggregator.get_rollup("bob"), 1, -10)
    }
}

class Step1RollupSnapshotSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,10")
        first = (aggregator.get_rollup("alice") ?? Rollup(-1, -1))
        aggregator.ingest("r2,2,alice,5")
        first.count.shouldBe(1)
        first.total.shouldBe(10)
        expect_rollup(aggregator.get_rollup("alice"), 2, 15)
    }
}
