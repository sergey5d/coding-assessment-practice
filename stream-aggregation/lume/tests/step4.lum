module step4

use spec/*
use src/record_aggregator/{RecordAggregator}
use support/assessment_support/{expect_strings}

class Step4RangeAggregationSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,20")
        aggregator.ingest("r2,15,alice,30")
        aggregator.ingest("r3,18,bob,40")
        expect_strings(aggregator.top_n_in_range(10, 20, 10), ["alice(2,50)", "bob(1,40)"])
    }
}

class Step4HalfOpenRangeSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,9,before,100")
        aggregator.ingest("r2,10,start,20")
        aggregator.ingest("r3,19,inside,30")
        aggregator.ingest("r4,20,end,200")
        expect_strings(aggregator.top_n_in_range(10, 20, 10), ["inside(1,30)", "start(1,20)"])
    }
}

class Step4OrderingSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,zoe,20")
        aggregator.ingest("r2,2,amy,20")
        aggregator.ingest("r3,3,bob,50")
        expect_strings(aggregator.top_n_in_range(0, 10, 3), ["bob(1,50)", "amy(1,20)", "zoe(1,20)"])
    }
}

class Step4LimitSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,10")
        aggregator.ingest("r2,2,bob,20")
        aggregator.ingest("r3,3,carol,30")
        expect_strings(aggregator.top_n_in_range(0, 10, 2), ["carol(1,30)", "bob(1,20)"])
    }
}

class Step4VoidedRecordsSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,100")
        aggregator.ingest("r2,11,alice,-20")
        aggregator.ingest("r3,12,bob,50")
        aggregator.void_record("r1")
        expect_strings(aggregator.top_n_in_range(0, 20, 10), ["bob(1,50)", "alice(1,-20)"])
    }
}

class Step4OutOfOrderSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,100,later,50")
        aggregator.ingest("r2,10,earlier,30")
        aggregator.ingest("r3,50,middle,40")
        expect_strings(aggregator.top_n_in_range(0, 60, 10), ["middle(1,40)", "earlier(1,30)"])
    }
}

class Step4ZeroTotalSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,zero,10")
        aggregator.ingest("r2,2,zero,-10")
        aggregator.ingest("r3,3,negative,-1")
        expect_strings(aggregator.top_n_in_range(0, 10, 10), ["zero(2,0)", "negative(1,-1)"])
    }
}

class Step4InvalidRangeSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,20")
        expect_strings(aggregator.top_n_in_range(0, 20, 0), [])
        expect_strings(aggregator.top_n_in_range(10, 10, 5), [])
        expect_strings(aggregator.top_n_in_range(20, 10, 5), [])
        expect_strings(aggregator.top_n_in_range(30, 40, 5), [])
    }
}

class Step4RejectedDuplicateSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,10,alice,20")
        aggregator.ingest("r1,11,alice,100").shouldBe(false)
        expect_strings(aggregator.top_n_in_range(0, 20, 10), ["alice(1,20)"])
    }
}

