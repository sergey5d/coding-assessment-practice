module step3

use spec/*
use src/record_aggregator/{RecordAggregator}
use support/assessment_support/{expect_rollup, expect_strings}

class Step3SingleContributionSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,20")
        aggregator.ingest("r2,2,alice,30")
        aggregator.void_record("r1").shouldBe(true)
        expect_rollup(aggregator.get_rollup("alice"), 1, 30)
    }
}

class Step3RejectedVoidSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,20")
        aggregator.void_record("missing").shouldBe(false)
        aggregator.void_record("r1").shouldBe(true)
        aggregator.void_record("r1").shouldBe(false)
    }
}

class Step3FinalRecordSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,20")
        aggregator.void_record("r1").shouldBe(true)
        aggregator.get_rollup("alice").isEmpty.shouldBe(true)
        expect_strings(aggregator.all_rollups(), [])
    }
}

class Step3ReservedIdSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,20")
        aggregator.void_record("r1")
        aggregator.ingest("r1,2,bob,100").shouldBe(false)
        aggregator.get_rollup("bob").isEmpty.shouldBe(true)
    }
}

class Step3SignedAmountSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,20")
        aggregator.ingest("r2,2,alice,-7")
        aggregator.void_record("r2").shouldBe(true)
        expect_rollup(aggregator.get_rollup("alice"), 1, 20)
    }
}

class Step3UpdatedOrderingSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,100")
        aggregator.ingest("r2,2,alice,-80")
        aggregator.ingest("r3,3,bob,50")
        expect_strings(aggregator.top_n(1), ["bob(1,50)"])
        aggregator.void_record("r2")
        expect_strings(aggregator.top_n(1), ["alice(1,100)"])
    }
}

class Step3IndependentKeysSpec with Spec {
    def it() Unit {
        aggregator = RecordAggregator {}
        aggregator.ingest("r1,1,alice,20")
        aggregator.ingest("r2,2,bob,30")
        aggregator.void_record("r1")
        aggregator.get_rollup("alice").isEmpty.shouldBe(true)
        expect_rollup(aggregator.get_rollup("bob"), 1, 30)
    }
}

