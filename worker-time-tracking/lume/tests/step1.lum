module step1

use spec/*
use src/worker_time_tracker/{WorkerTimeTracker}

class Step1DuplicateWorkerSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10).shouldBe(true)
        tracker.add_worker("alice", "manager", 100).shouldBe(false)
        tracker.register("alice", 2).shouldBe(true)
        tracker.register("alice", 7).shouldBe(true)
        (tracker.get("alice") ?? -1).shouldBe(5)
    }
}

class Step1UnknownWorkerSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.get("missing").isEmpty.shouldBe(true)
        tracker.register("missing", 1).shouldBe(false)
        tracker.get("missing").isEmpty.shouldBe(true)
    }
}

class Step1AlternatingRegistrationSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 3).shouldBe(true)
        tracker.register("alice", 11).shouldBe(true)
        tracker.register("alice", 20).shouldBe(true)
        tracker.register("alice", 25).shouldBe(true)
        (tracker.get("alice") ?? -1).shouldBe(13)
    }
}

class Step1OpenSessionSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 4)
        (tracker.get("alice") ?? -1).shouldBe(0)
        tracker.register("alice", 14)
        tracker.register("alice", 20)
        (tracker.get("alice") ?? -1).shouldBe(10)
    }
}

class Step1IndependentWorkersSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.add_worker("bob", "engineer", 20)
        tracker.register("alice", 1)
        tracker.register("bob", 2)
        tracker.register("alice", 6)
        (tracker.get("alice") ?? -1).shouldBe(5)
        (tracker.get("bob") ?? -1).shouldBe(0)
        tracker.register("bob", 10)
        (tracker.get("bob") ?? -1).shouldBe(8)
    }
}

