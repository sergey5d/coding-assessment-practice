module step4

use spec/*
use src/worker_time_tracker/{WorkerTimeTracker}
use support/assessment_support/{expect_strings}

class Step4OvertimeRateSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.set_overtime("alice", 5)
        tracker.register("alice", 1)
        tracker.register("alice", 11)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(150)
    }
}

class Step4ExactThresholdSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.set_overtime("alice", 5)
        tracker.register("alice", 10)
        tracker.register("alice", 15)
        (tracker.calc_salary("alice", 0, 100) ?? -1).shouldBe(50)
    }
}

class Step4PerSessionResetSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.set_overtime("alice", 5)
        tracker.register("alice", 1)
        tracker.register("alice", 5)
        tracker.register("alice", 10)
        tracker.register("alice", 14)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(80)
    }
}

class Step4SessionBoundarySpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.set_overtime("alice", 5)
        tracker.register("alice", 10)
        tracker.register("alice", 30)
        (tracker.calc_salary("alice", 18, 22) ?? -1).shouldBe(80)
        (tracker.calc_salary("alice", 13, 17) ?? -1).shouldBe(60)
    }
}

class Step4PromotedCompensationSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.set_overtime("alice", 2)
        tracker.register("alice", 1)
        tracker.register("alice", 5)
        tracker.promote("alice", "lead", 20, 10)
        tracker.register("alice", 10)
        tracker.register("alice", 14)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(180)
    }
}

class Step4RetroactiveThresholdSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 1)
        tracker.register("alice", 11)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(100)
        tracker.set_overtime("alice", 8).shouldBe(true)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(120)
        tracker.set_overtime("alice", 3).shouldBe(true)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(170)
    }
}

class Step4ZeroThresholdSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 7)
        tracker.set_overtime("alice", 0)
        tracker.register("alice", 2)
        tracker.register("alice", 7)
        (tracker.calc_salary("alice", 0, 10) ?? -1).shouldBe(70)
    }
}

class Step4UnknownWorkerSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.set_overtime("missing", 5).shouldBe(false)
        tracker.get("missing").isEmpty.shouldBe(true)
    }
}

class Step4DoesNotChangeTimeSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.set_overtime("alice", 2)
        tracker.register("alice", 1)
        tracker.register("alice", 11)
        (tracker.get("alice") ?? -1).shouldBe(10)
        expect_strings(tracker.top_n_workers(1, "engineer"), ["alice(10)"])
    }
}

