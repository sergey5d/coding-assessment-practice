module step3

use spec/*
use src/worker_time_tracker/{WorkerTimeTracker}
use support/assessment_support/{expect_strings}

class Step3PendingPromotionSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.promote("missing", "lead", 20, 10).shouldBe(false)
        tracker.add_worker("alice", "engineer", 10)
        tracker.promote("alice", "lead", 20, 10).shouldBe(true)
        tracker.promote("alice", "director", 30, 20).shouldBe(false)
    }
}

class Step3QualifyingEntrySpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.promote("alice", "lead", 20, 10)
        expect_strings(tracker.top_n_workers(5, "engineer"), ["alice(0)"])
        expect_strings(tracker.top_n_workers(5, "lead"), [])
        tracker.register("alice", 9)
        tracker.register("alice", 12)
        expect_strings(tracker.top_n_workers(5, "engineer"), ["alice(3)"])
        tracker.register("alice", 13)
        expect_strings(tracker.top_n_workers(5, "engineer"), [])
        expect_strings(tracker.top_n_workers(5, "lead"), ["alice(0)"])
    }
}

class Step3ExitDoesNotPromoteSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 1)
        tracker.promote("alice", "lead", 20, 5)
        tracker.register("alice", 10)
        expect_strings(tracker.top_n_workers(5, "engineer"), ["alice(9)"])
        expect_strings(tracker.top_n_workers(5, "lead"), [])
        tracker.register("alice", 11)
        expect_strings(tracker.top_n_workers(5, "lead"), ["alice(0)"])
    }
}

class Step3ExactPromotionTimeSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.promote("alice", "lead", 20, 10)
        tracker.register("alice", 10)
        tracker.register("alice", 15)
        expect_strings(tracker.top_n_workers(5, "engineer"), [])
        expect_strings(tracker.top_n_workers(5, "lead"), ["alice(5)"])
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(100)
    }
}

class Step3PositionTimeSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 1)
        tracker.register("alice", 11)
        tracker.promote("alice", "lead", 20, 15)
        tracker.register("alice", 15)
        tracker.register("alice", 19)
        (tracker.get("alice") ?? -1).shouldBe(14)
        expect_strings(tracker.top_n_workers(5, "engineer"), [])
        expect_strings(tracker.top_n_workers(5, "lead"), ["alice(4)"])
    }
}

class Step3CapturedCompensationSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 1)
        tracker.register("alice", 6)
        tracker.promote("alice", "lead", 25, 10)
        tracker.register("alice", 10)
        tracker.register("alice", 14)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(150)
    }
}

class Step3SpanningSessionSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 1)
        tracker.promote("alice", "lead", 100, 5)
        tracker.register("alice", 10)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(90)
        tracker.register("alice", 11)
        tracker.register("alice", 12)
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(190)
    }
}

class Step3SalaryClippingSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 7)
        tracker.register("alice", 10)
        tracker.register("alice", 30)
        (tracker.calc_salary("alice", 0, 10) ?? -1).shouldBe(0)
        (tracker.calc_salary("alice", 10, 30) ?? -1).shouldBe(140)
        (tracker.calc_salary("alice", 15, 25) ?? -1).shouldBe(70)
        (tracker.calc_salary("alice", 30, 40) ?? -1).shouldBe(0)
        (tracker.calc_salary("alice", 20, 20) ?? -1).shouldBe(0)
    }
}

class Step3OpenSalarySpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.register("alice", 1)
        (tracker.calc_salary("alice", 0, 100) ?? -1).shouldBe(0)
        tracker.register("alice", 11)
        tracker.register("alice", 20)
        (tracker.calc_salary("alice", 0, 100) ?? -1).shouldBe(100)
        tracker.calc_salary("missing", 0, 100).isEmpty.shouldBe(true)
    }
}

class Step3SubsequentPromotionSpec with Spec {
    def it() Unit {
        tracker = WorkerTimeTracker {}
        tracker.add_worker("alice", "engineer", 10)
        tracker.promote("alice", "lead", 20, 5)
        tracker.register("alice", 5)
        tracker.promote("alice", "director", 30, 10).shouldBe(true)
        tracker.register("alice", 8)
        tracker.register("alice", 10)
        tracker.register("alice", 12)
        expect_strings(tracker.top_n_workers(5, "lead"), [])
        expect_strings(tracker.top_n_workers(5, "director"), ["alice(2)"])
        (tracker.calc_salary("alice", 0, 20) ?? -1).shouldBe(120)
    }
}

